    users {
        int id PK
        bigint telegram_id UK "Telegram account id"
        string username "nullable"
        string first_name "nullable"
        string language "fa | en"
        bool is_blocked
        datetime last_seen_at "nullable, not updated"
        datetime created_at
        datetime updated_at
    }

    user_settings {
        int id PK
        int user_id FK
        string personality "10 presets"
        string style "6 presets"
        string tone "5 presets"
        string creativity "low | balanced | high"
        bool memory_enabled
        string response_language "auto | fa | en"
        bool emoji_enabled
        text custom_instructions "nullable"
        string model "nullable"
        string provider "nullable"
        int current_conversation_id "nullable, loose"
        int default_persona_id "nullable, loose"
        bool auto_routing
        datetime created_at
        datetime updated_at
    }

    personas {
        int id PK
        int user_id FK
        string name "unique per user"
        text instructions
        string emoji
        bool is_default
        datetime created_at
        datetime updated_at
    }

    conversations {
        int id PK
        int user_id FK
        string title
        bool is_archived
        bool is_pinned
        text summary "nullable"
        int persona_id "nullable, loose"
        string model "nullable"
        datetime created_at
        datetime updated_at
    }

    messages {
        int id PK
        int conversation_id FK
        string role "system | user | assistant"
        text content
        datetime created_at
        datetime updated_at
    }

    prompts {
        int id PK
        int user_id FK
        string title
        text body
        string category
        datetime created_at
        datetime updated_at
    }

    user_memory {
        int id PK
        int user_id FK
        string key "unique per user"
        text value
        datetime created_at
        datetime updated_at
    }

    ai_providers {
        int id PK
        string name UK
        string base_url
        string model
        text api_key "plaintext at rest"
        bool is_active
        string capabilities "csv task classes"
        datetime created_at
        datetime updated_at
    }

    usage_logs {
        int id PK
        int user_id FK "nullable, SET NULL"
        string action "chat | summarize | ..."
        string provider "nullable"
        string model "nullable"
        bool success
        text error "nullable"
        int latency_ms "nullable"
        int prompt_tokens
        int completion_tokens
        datetime created_at
        datetime updated_at
    }

    schema_version {
        int version PK
        text description
        timestamp applied_at
    }
